# CMS / backend API origin (no trailing slash).
# Required for articles, insights, contact, projects, team, testimonials.
NEXT_PUBLIC_API_URL=https://your-api-host.example.com

# Optional: server-only (e.g. ArticleDetail). If unset, NEXT_PUBLIC_API_URL is used.
# API_URL=https://your-api-host.example.com

# Copy this file to .env.local and replace the URL.
# NEXT_PUBLIC_* is inlined at build time for the browser — after changing it, run:
#   npm run build
